# ═══════════════════════════════════════════════════════════════════
# Plantilla de variables de entorno — copiar a .env y completar valores
# reales. .env está en .gitignore y nunca debe subirse al repositorio.
# ═══════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════
# API
# ═══════════════════════════════════════════════════════════════════
API_TITLE=Sistema de Vectorizacion Documental v2
API_VERSION=2.0.0
API_HOST=0.0.0.0
API_PORT=8100
DEBUG=False

# ═══════════════════════════════════════════════════════════════════
# Storage
# ═══════════════════════════════════════════════════════════════════
TEMP_DIR=./temp_docs
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=[".pdf", ".docx", ".pptx", ".ppt", ".xlsx", ".jpg", ".jpeg", ".png", ".webp", ".mp4", ".mov", ".webm", ".mkv", ".mp3", ".wav", ".m4a", ".ogg"]

# ═══════════════════════════════════════════════════════════════════
# Entorno activo — DESARROLLO o PRODUCCION. Determina qué bloque
# _DESARROLLO/_PRODUCCION usan Postgres y Qdrant (ver más abajo).
# ═══════════════════════════════════════════════════════════════════
ENV=DESARROLLO

# ═══════════════════════════════════════════════════════════════════
# Qdrant — un bloque por entorno, seleccionado por ENV arriba.
# ═══════════════════════════════════════════════════════════════════
QDRANT_HOST_DESARROLLO=localhost
QDRANT_PORT_DESARROLLO=6333
QDRANT_API_KEY_DESARROLLO=
QDRANT_HTTPS_DESARROLLO=False

QDRANT_HOST_PRODUCCION=localhost
QDRANT_PORT_PRODUCCION=6333
QDRANT_API_KEY_PRODUCCION=
QDRANT_HTTPS_PRODUCCION=False

DEFAULT_VECTOR_SIZE=1536
DEFAULT_DISTANCE=Cosine

# ═══════════════════════════════════════════════════════════════════
# API Externa (no usada actualmente por el codigo, requerida por settings.py)
# ═══════════════════════════════════════════════════════════════════
COLLECTIONS_API_URL=http://localhost:8100/api/collections

# ═══════════════════════════════════════════════════════════════════
# Embeddings
# ═══════════════════════════════════════════════════════════════════
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── Azure Embeddings (solo si EMBEDDING_MODEL=text-embedding-3-small) ──
AZURE_EMBEDDING_KEY=
AZURE_EMBEDDING_ENDPOINT=
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_EMBEDDING_API_VERSION=2024-05-01-preview

# ═══════════════════════════════════════════════════════════════════
# Text Processing
# ═══════════════════════════════════════════════════════════════════
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# ═══════════════════════════════════════════════════════════════════
# ASR (audio/video) y OCR (imagenes)
# ═══════════════════════════════════════════════════════════════════
ASR_MODEL_SIZE=base
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
OCR_LANGUAGES=es,en

# ═══════════════════════════════════════════════════════════════════
# Moodle
# ═══════════════════════════════════════════════════════════════════
MOODLE_URL=
MOODLE_TOKEN=

# ── Moodle DB (solo lectura, opcional — fechas de vencimiento reales) ──
MOODLE_DB_HOST=
MOODLE_DB_PORT=3306
MOODLE_DB_NAME=
MOODLE_DB_USER=
MOODLE_DB_PASSWORD=

# ═══════════════════════════════════════════════════════════════════
# ERP (MySQL, solo lectura) — cursos del docente para el panel docente
# ═══════════════════════════════════════════════════════════════════
ERP_MYSQL_HOST=
ERP_MYSQL_PORT=3306
ERP_MYSQL_USER=
ERP_MYSQL_PASSWORD=
ERP_MYSQL_DB=

# ═══════════════════════════════════════════════════════════════════
# Panel del docente
# ═══════════════════════════════════════════════════════════════════
# TEMPORAL: deshabilitado desde 2026-10-21 (ver app.py login_page) —
# dejar vacío mientras no se restaure/reemplace ese control.
DOCENTE_LOGIN_TOKEN=
DOCENTE_DEFAULT_DENSE=openai/text-embedding-3-small
DOCENTE_DEFAULT_SPARSE=bm25

# ═══════════════════════════════════════════════════════════════════
# LLM Generation & Vision (Pipeline RAG) — todas opcionales
# ═══════════════════════════════════════════════════════════════════
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
COHERE_API_KEY=
DEEPGRAM_API_KEY=

# ═══════════════════════════════════════════════════════════════════
# RAG Pipeline Defaults (Strategy Pattern) — ver settings.py AVAILABLE_*
# ═══════════════════════════════════════════════════════════════════
ETL_DOCUMENT_STRATEGY=local
ETL_AUDIO_STRATEGY=faster_whisper_local
CONTEXTUAL_STRATEGY=none
SPARSE_EMBEDDING_STRATEGY=bm25
RERANK_STRATEGY=none
RERANK_TOP_K=50
RERANK_TOP_N=5
RERANK_BOOST_MULTIPLIER=1.15
GENERATION_STRATEGY=gpt4o_mini

# ═══════════════════════════════════════════════════════════════════
# Postgres (configuracion del gestor, asistentes, RD) — un bloque por
# entorno, seleccionado por ENV arriba.
# ═══════════════════════════════════════════════════════════════════
PG_HOST_DESARROLLO=localhost
PG_PORT_DESARROLLO=5432
PG_USER_DESARROLLO=postgres
PG_PASSWORD_DESARROLLO=
PG_DATABASE_DESARROLLO=U_F1_Profundizacion_desarrollo

PG_HOST_PRODUCCION=
PG_PORT_PRODUCCION=5432
PG_USER_PRODUCCION=postgres
PG_PASSWORD_PRODUCCION=
PG_DATABASE_PRODUCCION=U_F1_Profundizacion

# ═══════════════════════════════════════════════════════════════════
# Autenticacion del gestor (/gestor) — cambiar despues del primer login
# ═══════════════════════════════════════════════════════════════════
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET_KEY=

# ═══════════════════════════════════════════════════════════════════
# Asistentes publicos
# ═══════════════════════════════════════════════════════════════════
PUBLIC_BASE_URL=http://localhost:8100

# ═══════════════════════════════════════════════════════════════════
# Prefijo de URL (solo produccion, si el gestor comparte dominio con otras
# funcionalidades detras de un mismo nginx). Vacio = la app sirve en la raiz
# (asi debe quedar en desarrollo local). Ej. produccion: URL_PREFIX=/f1
# ═══════════════════════════════════════════════════════════════════
URL_PREFIX=
