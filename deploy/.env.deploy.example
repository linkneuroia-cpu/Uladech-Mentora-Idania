# Copiar este archivo a deploy/.env.deploy y completar con los datos
# reales. deploy/.env.deploy NUNCA se commitea (ver .gitignore) — mismo
# criterio que el .env de la app para sus propios secretos.

DEPLOY_HOST=10.0.0.92
DEPLOY_USER=neuroia26
DEPLOY_PASSWORD=""
# Ojo: tiene un espacio ("Funcionalidad 1") — hay que dejarlo entre
# comillas (como acá) para que "source" no lo rompa en dos.
DEPLOY_PATH="proyectos/01_f1/Funcionalidad 1/gestor"

# Solo para deploy/deploy_git.sh (despliegue basado en Git). Si el repo es
# privado, incluir credenciales en la URL misma:
#   https://<usuario>:<token>@github.com/linkneuroia-cpu/Uladech-Mentora-Idania.git
# o usar una URL git@... con una clave de despliegue ya configurada en el
# servidor. deploy/upload.sh + deploy/deploy.sh (el flujo viejo, por
# tar/scp) no usan esta variable.
GIT_REMOTE_URL=https://github.com/linkneuroia-cpu/Uladech-Mentora-Idania.git
